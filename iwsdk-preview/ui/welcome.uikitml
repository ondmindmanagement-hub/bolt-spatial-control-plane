<!-- One seated, controllerless, synthetic workflow review panel.
     No company logos or corporate advertising in the contest app. -->
<style>
  .panel-root { width: 444px; flex-direction: column; }
  .body { flex-direction: column; padding: 20px; gap: 10px; }
  .eyebrow { font-size: 14px; color: #699bdc; font-weight: 700; }
  .title { font-size: 25px; color: #1b273b; font-weight: 700; }
  .detail { font-size: 15px; color: #334155; line-height: 20px; }
  .risk { font-size: 13px; color: #954424; }
  .outcome { font-size: 16px; color: #185b48; font-weight: 700; margin-top: 5px; }
  .history { font-size: 11px; color: #536175; margin-top: 4px; }
  .row { flex-direction: row; gap: 8px; padding-left: 20px; padding-right: 20px; padding-bottom: 18px; }
  .button { flex-grow: 1; flex-basis: 0; justify-content: center; }
  .nav { margin-top: 5px; margin-left: 20px; margin-right: 20px; margin-bottom: 12px; }
</style>
<Panel class="panel-root">
  <div class="body">
    <p class="eyebrow">SPATIAL REVIEW ROOM / TEST ONLY</p>
    <p id="progress" class="eyebrow">CASE 1 / 3</p>
    <h1 id="case-title" class="title">Review a status summary</h1>
    <Divider></Divider>
    <p id="case-detail" class="detail">One fabricated status report.</p>
    <p id="case-risk" class="risk">LOW RISK</p>
    <p id="outcome" class="outcome">Awaiting your choice</p>
    <p id="history" class="history">Synthetic review started</p>
  </div>
  <div class="row">
    <Button class="button" id="approve-button"><ButtonLabel>Approve</ButtonLabel></Button>
    <Button class="button" id="reject-button"><ButtonLabel>Reject</ButtonLabel></Button>
    <Button class="button" id="next-button" style="display: none"><ButtonLabel>Next Case</ButtonLabel></Button>
    <Button class="button" id="reset-button" style="display: none"><ButtonLabel>Restart</ButtonLabel></Button>
  </div>
  <Button id="xr-button" class="nav"><ButtonLabel>Enter XR</ButtonLabel></Button>
  <Button id="exit-button" class="nav" style="display: none"><ButtonLabel>Exit to browser</ButtonLabel></Button>
</Panel>
